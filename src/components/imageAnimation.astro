---
import Image from "astro/components/Image.astro";
import img1 from "../images/imgsHero/1S.webp";
import img2 from "../images/imgsHero/2S.webp";
import img3 from "../images/imgsHero/3SU.webp";
import img4 from "../images/imgsHero/4SU.webp";
import img5 from "../images/imgsHero/5A.webp";
import img6 from "../images/imgsHero/6A.webp";
import img7 from "../images/imgsHero/7W.webp";
import img8 from "../images/imgsHero/8W.webp";
---

<div class="w-3/4 h-4/5 md:w-[280px] md:h-[320px] lg:w-[360px] lg:h-[460px] rounded-lg relative overflow-hidden ">
  <Image
    src={img1}
    alt="img1"
    class="slide"
    style="animation-delay: -0s;"
    loading="eager"
  />
  <Image
    src={img2}
    alt="img2"
    class="slide"
    style="animation-delay: -2.5s;"
    loading="eager"
  />
  <Image
    src={img3}
    alt="img3"
    class="slide"
    style="animation-delay: -5s;"
    loading="eager"
  />
  <Image
    src={img4}
    alt="img4"
    class="slide"
    style="animation-delay: -7.5s;"
    loading="eager"
  />
  <Image
    src={img5}
    alt="img5"
    class="slide"
    style="animation-delay: -10s;"
    loading="eager"
  />
  <Image
    src={img6}
    alt="img6"
    class="slide"
    style="animation-delay: -12.5s;"
    loading="eager"
  />
  <Image
    src={img7}
    alt="img7"
    class="slide"
    style="animation-delay: -15s;"
    loading="eager"
  />
  <Image
    src={img8}
    alt="img8"
    class="slide"
    style="animation-delay: -17.5s;"
    loading="eager"
  />
</div>

<style is:global>
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0;
    animation: slideShow 20s linear infinite;
    transition: opacity 1ms ease;
  }

  @keyframes slideShow {
    0% {
      opacity: 1;
    }
    10% {
      opacity: 1;
    }
    15% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>