---
import Image from "astro/components/Image.astro";
import img1Lg from "../images/imgsHero/1Lg.webp";
import img1Sm from '../images/imgsHero/1Sm.webp'
import img2Lg from '../images/imgsHero/2Lg.webp'
import img2Sm from "../images/imgsHero/2Sm.webp";
import img3Lg from '../images/imgsHero/3Lg.webp'
import img3Sm from "../images/imgsHero/3Sm.webp";
import img4Lg from '../images/imgsHero/4Lg.webp'
import img4Sm from "../images/imgsHero/4Sm.webp";
import img5Lg from '../images/imgsHero/5Lg.webp'
import img5Sm from "../images/imgsHero/5Sm.webp";
import img6Lg from '../images/imgsHero/6Lg.webp'
import img6Sm from "../images/imgsHero/6Sm.webp";
import img7Lg from '../images/imgsHero/7Lg.webp'
import img7Sm from "../images/imgsHero/7Sm.webp";
import img8Lg from '../images/imgsHero/8Lg.webp'
import img8Sm from "../images/imgsHero/8Sm.webp";


let w = false;
if (typeof window !== "undefined" && window.innerWidth <= 1024) {
  w = true;
}

---

<div class="w-3/4 h-4/5 md:w-[280px] md:h-[320px] lg:w-[360px] lg:h-[460px] rounded-lg relative overflow-hidden ">
  <Image
    src={w ? img1Lg : img1Sm}
    alt="img1"
    class="slide"
    style="animation-delay: -0s;"
    loading="eager"
  />
  <Image
    src={w ? img2Lg :img2Sm}
    alt="img2"
    class="slide"
    style="animation-delay: -2.5s;"
    loading="eager"
  />
  <Image
    src={w ? img3Lg :img3Sm}
    alt="img3"
    class="slide"
    style="animation-delay: -5s;"
    loading="eager"
  />
  <Image
    src={w ? img4Lg :img4Sm}
    alt="img4"
    class="slide"
    style="animation-delay: -7.5s;"
    loading="eager"
  />
  <Image
    src={w ? img5Lg :img5Sm}
    alt="img5"
    class="slide"
    style="animation-delay: -10s;"
    loading="eager"
  />
  <Image
    src={w ? img6Lg :img6Sm}
    alt="img6"
    class="slide"
    style="animation-delay: -12.5s;"
    loading="eager"
  />
  <Image
    src={w ? img7Lg :img7Sm}
    alt="img7"
    class="slide"
    style="animation-delay: -15s;"
    loading="eager"
  />
  <Image
    src={w ? img8Lg :img8Sm}
    alt="img8"
    class="slide"
    style="animation-delay: -17.5s;"
    loading="eager"
  />
</div>

<style is:global>
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0;
    animation: slideShow 20s linear infinite;
    transition: opacity 1ms ease;
  }

  @keyframes slideShow {
    0% {
      opacity: 1;
    }
    10% {
      opacity: 1;
    }
    15% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>