---
import Buttons from "../buttons.astro";
---

<section class="h-screen p-8 flex flex-col justify-evenly">
  <div class="flex w-full justify-between">
    <p>Paso 8 - 10</p>
    <div class="flex gap-4">
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text="<"
      />
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text=">"
      />
    </div>
  </div>
  <p class="text-xl text-center">¿Que colores prefieres usar?</p>
  <div class="h-[516px] grid grid-cols-3 w-full gap-5 justify-around">
    <div class="flex flex-col gap-4 items-center">
      <p>Calidos</p>
      <label
        class="h-full w-full rounded-lg relative overflow-hidden hover:cursor-pointer group"
        title="Calidos"
      >
        <input
          type="radio"
          name="colores"
          id="coloresCalidos"
          value="Calidos"
          class="hidden"
        />
        <div class="flex gap-2 w-full h-full items-center justify-center">
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#FF0000] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#FFA500] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#FFFF00] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
        </div>
      </label>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Frios</p>
      <label
        class="h-full w-full rounded-lg relative overflow-hidden hover:cursor-pointer group"
        title="Frios"
      >
        <input
          type="radio"
          name="colores"
          id="coloresFrios"
          value="Frios"
          class="hidden"
        />
        <div class="flex gap-2 w-full h-full items-center justify-center">
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#0000FF] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#008000] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#EE82EE] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
        </div>
      </label>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Neutros</p>
      <label
        class="h-full w-full rounded-lg relative overflow-hidden hover:cursor-pointer group"
        title="Neutros"
      >
        <input
          type="radio"
          name="colores"
          id="coloresNeutros"
          value="Neutros"
          class="hidden"
        />
        <div class="flex w-full h-full gap-2 items-center justify-center">
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#FFFFFF] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#000000] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
          <div
            class="w-[130px] h-[130px] rounded-full border border-[#D1C7B7] bg-[#AAAAAA] shadow-inner shadow-black/40 group-hover:scale-105 transition-all ease-linear delay-200"
          >
          </div>
        </div>
      </label>
    </div>
  </div>
</section>
