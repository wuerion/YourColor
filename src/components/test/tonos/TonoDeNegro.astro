---
import Buttons from "../../buttons.astro";
---

<section class="h-screen p-8 flex flex-col justify-evenly">
  <div class="flex w-full justify-between">
    <p>Paso 5 - 10</p>
    <div class="flex gap-4">
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text="<"
      />
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text=">"
      />
    </div>
  </div>
  <p class="text-xl text-center">¿Cual es tu tono de negro?</p>
  <div class="h-[516px] grid grid-cols-2 gap-5 justify-around">
    <div class="flex flex-col gap-4 items-center">
      <p>Negro Azulado (Frio)</p>
      <label
        class="h-full w-full rounded-lg overflow-hidden flex items-center justify-evenly group hover:cursor-pointer"
        title="Negro Azulado"
      >
        <input
          type="radio"
          name="tonoDeNegro"
          id="negroAzulado"
          value="Negro Azulado"
          class="hidden"
        />
        <div
          class="h-[130px] w-[130px] rounded-full bg-gradient-to-r from-[#243B55] from-50% to-[#000000] to-50% rotate-45 shadow-inner shadow-black/40 group-hover:scale-105 delay-200 transition-all ease-linear border border-[#D1C7B7]"
        >
        </div>
      </label>
      <p class="text-lg max-w-[300px]">
        Descripción: Negro profundo e intenso. Bajo la luz brilla con tonos
        azulados o plateados, no marrones.
      </p>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Negro Suave / Cafe (Calido)</p>
      <label
        class="h-full w-full rounded-lg overflow-hidden flex items-center justify-evenly group hover:cursor-pointer"
        title="Negro Suave/Cafe"
      >
        <input
          type="radio"
          name="tonoDeNegro"
          id="negroSuave"
          value="Negro Suave/Cafe"
          class="hidden"
        />
        <div
          class="h-[130px] w-[130px] rounded-full bg-gradient-to-r from-[#1C1B1B] from-50% to-[#332620] to-50% rotate-45 shadow-inner shadow-black/40 group-hover:scale-105 delay-200 transition-all ease-linear border border-[#D1C7B7]"
        >
        </div>
      </label>
      <p class="text-lg max-w-[300px]">
        Descripción: Parece negro a simple vista, pero bajo el sol se percibe un
        matiz marrón muy oscuro o chocolate amargo.
      </p>
    </div>
  </div>
</section>
