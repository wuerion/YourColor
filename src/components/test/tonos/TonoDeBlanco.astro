---
import Buttons from "../../buttons.astro";
---

<section class="h-screen p-8 flex flex-col justify-evenly">
  <div class="flex w-full justify-between">
    <p>Paso 5 - 10</p>
    <div class="flex gap-4">
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text="<"
      />
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text=">"
      />
    </div>
  </div>
  <p class="text-xl text-center">¿Cual es tu tono de gris / blanco?</p>
  <div class="h-[516px] grid grid-cols-2 gap-5 justify-around">
    <div class="flex flex-col gap-4 items-center">
      <p>Plata / Blanco Nieve (Frio)</p>
      <label
        class="h-full w-full rounded-lg overflow-hidden flex items-center justify-evenly group hover:cursor-pointer"
        title="Plata / Blanco Nieve"
      >
        <input
          type="radio"
          name="TonoDeGris"
          id="platino"
          value="Platino / Blanco Nieve"
          class="hidden"
        />
        <div
          class="h-[130px] w-[130px] rounded-full bg-gradient-to-r from-[#C0C0C0] from-50% to-[#ffffff] to-50% rotate-45 shadow-inner shadow-black/40 group-hover:scale-105 delay-200 transition-all ease-linear border border-[#D1C7B7]"
        >
        </div>
      </label>
      <p class="text-lg max-w-[300px]">
        Descripción: Canas blancas brillantes o gris acero. Se ve limpio,
        metálico y frío.
      </p>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Crema / Perla (Calido)</p>
      <label
        class="h-full w-full rounded-lg overflow-hidden flex items-center justify-evenly group hover:cursor-pointer"
        title="Crema / Perla "
      >
        <input
          type="radio"
          name="TonoDeGris"
          id="crema"
          value="Crema / Perla"
          class="hidden"
        />
        <div
          class="h-[130px] w-[130px] rounded-full bg-gradient-to-r from-[#D1CBB1] from-50% to-[#F4F1EA] to-50% rotate-45 shadow-inner shadow-black/40 group-hover:scale-105 delay-200 transition-all ease-linear border border-[#D1C7B7]"
        >
        </div>
      </label>
      <p class="text-lg max-w-[300px]">
        Descripción: Canas suaves que tienden a un tono beige, marfil o
        amarillento, no totalmente blanco.
      </p>
    </div>
  </div>
</section>
