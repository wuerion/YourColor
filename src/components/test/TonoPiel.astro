---
import Image from "astro/components/Image.astro";
import Buttons from "../buttons.astro";
import MuyClara from "/src/images/TonoDePielImages/MuyClara.jpg";
import Clara from "/src/images/TonoDePielImages/Clara.jpg";
import Media from "/src/images/TonoDePielImages/Media.jpg";
import Oscura from "/src/images/TonoDePielImages/Oscura.jpg";
---

<section class="h-screen p-8 flex flex-col justify-evenly">
  <div class="flex w-full justify-between">
    <p>Paso 1 - 10</p>
    <div>
      <Buttons
        link2="hidden"
        button="hidden"
        link="border-none text-xl "
        text=">"
      />
    </div>
  </div>
  <p class="text-2xl text-center">¿Cual es tu tono de piel?</p>
  <div class="h-[516px] grid grid-cols-4 gap-5 justify-around">
    <div class="flex flex-col gap-4 items-center">
      <p>Muy clara</p>
      <label
        class="max-h-[516px] h-full w-full max-w-[355px] rounded-lg relative overflow-hidden hover:cursor-pointer group shadow-[inset_0_0_24px_8px_rgba(0,0,0,40%)]"
        title="Muy Clara"
      >
        <input
          type="radio"
          name="TonoDePiel"
          id="muyClara"
          value="Muy Clara"
          class="hidden"
        />
        <Image
          src={MuyClara}
          alt="Persona con piel muy clara"
          class="absolute -z-10 group-hover:scale-105 delay-200 transition-all ease-linear w-full h-full"
        />
      </label>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Clara</p>
      <label
        class="max-h-[516px] h-full w-full max-w-[355px] rounded-lg relative overflow-hidden hover:cursor-pointer group shadow-[inset_0_0_24px_8px_rgba(0,0,0,40%)]"
        title="Clara"
      >
        <input
          type="radio"
          name="TonoDePiel"
          id="clara"
          value="Clara"
          class="hidden"
        />
        <Image
          src={Clara}
          alt="Persona con piel clara"
          class="absolute -z-10 group-hover:scale-105 delay-200 ease-linear transition-all w-full h-full"
        />
      </label>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Media</p>
      <label
        class="max-h-[516px] h-full w-full max-w-[355px] rounded-lg relative overflow-hidden hover:cursor-pointer group shadow-[inset_0_0_24px_8px_rgba(0,0,0,40%)]"
        title="Media"
      >
        <input
          type="radio"
          name="TonoDePiel"
          id="media"
          value="Media"
          class="hidden"
        />
        <Image
          src={Media}
          alt="Persona con piel media"
          class="absolute -z-10 group-hover:scale-105 delay-200 ease-linear transition-all w-full h-full"
        />
      </label>
    </div>
    <div class="flex flex-col gap-4 items-center">
      <p>Oscura</p>
      <label
        class="max-h-[516px] h-full w-full max-w-[355px] rounded-lg relative overflow-hidden hover:cursor-pointer group shadow-[inset_0_0_24px_8px_rgba(0,0,0,40%)]"
        title="Oscura"
      >
        <input
          type="radio"
          name="TonoDePiel"
          id="oscura"
          value="Oscura"
          class="hidden"
        />
        <Image
          src={Oscura}
          alt="Persona con piel Oscura"
          class="absolute -z-10 group-hover:scale-105 delay-200 ease-linear transition-all w-full h-full"
        />
      </label>
    </div>
  </div>
</section>
