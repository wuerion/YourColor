---
const { text, addClass, link, link1, link2, linkL2, button, id } = Astro.props;
---

<div class=`${addClass} font-lato `>
    <a href=`${link1}` title={text} class=`text-black rounded-md px-1 py-2 md:p-2 hover:bg-white/50 border border-black ${link}` id="link"> {text}</a>
    <a href=`${linkL2}` title={text} class=`text-black rounded-md px-1 py-2 md:p-2 hover:bg-white/50 border border-black ${link2}` id="button">{text}</a>
    <button title={text} class=`text-black rounded-md px-1 py-2 md:p-2 hover:bg-white/50 border border-black ${button}` id=`${id}` type="button">{text}</button>
</div>