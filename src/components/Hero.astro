---
import Button from './buttons.astro'
import Images from './images.astro'
import mobileImage from '/public/color-circle.webp'
import desktopImage from '/public/color-circle.webp'
---

<section class="px-5 py-10 flex justify-center items-center">
  <div class="w-1/2">
    <h1 class="font-lato text-2xl text-start font-bold text-nowrap mr-2">
      ¿Quieres saber tu Colorimetría?
    </h1>
    <h2 class="font-lato text-lg mt-2">
      Conoce qué colores complementan mejor tu estilo y cómo reflejan tu personalidad aquí
      <Button text="Iniciar Test" addClass="flex" link="mt-2 trasition delay-150 duration-300 ease-in-out" link1="#test" link2="hidden" button="hidden"/>
    </h2>
  </div>
  <div class="w-1/2 flex justify-center items-center">
    <div class="w-28 lg:w-48 p-3 md:h-full">
      <Images
      mobileImgUrl={mobileImage}
      desktopImgUrl={desktopImage}
      alt='color palette circle'
      addClass='animate-spin-slow'
      />
    </div>
  </div>
</section>
