---
import Button from "./buttons.astro";
import Images from "../components/images.astro";
import ColorCircle from "../images/color-circle.webp";
---
<section class="grid grid-cols-5 px-3.5 py-10">
    <div class="w-full col-span-4 md:col-span-3 border flex flex-col gap-2">
        <div>
            <h2 class="text-xl text-start font-bold text-nowrap">
                ¿Quieres saber tu Colorimetría?
            </h2>
        </div>

        <h2>
            conoce qué colores complementan mejor tu estilo y cómo reflejan tu
            personalidad aquí <br />
            <Button
                text="¡Comienza a explorar tu colorimetría hoy!"
                addClass="flex text-nowrap"
                link=""
                link1="#test"
                link2="hidden"
                button="hidden"
            />
        </h2>
    </div>

    <div
        class="col-start-5 md:col-start-5 lg:col-start-4 flex items-center w-full justify-center"
    >
        <Images
            ImgUrl={ColorCircle}
            alt="color palet circle"
            addClass="w-20 h-20 md:size-32 lg:size-40 animate-spin-slow "
        />
    </div>
</section>
