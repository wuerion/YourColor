---
import Button from "./buttons.astro";
import ImageAnimation from "./imageAnimation.astro";
---

<section class=" min-h-[400px] h-[600px] max-h-[700px] -mx-4 lg:h-[534px] lg:max-h-[770px] ">
  <!-- min-h-[400px] h-[500px] max-h-[600px] lg:h-[534px] lg:max-h-[570px] -->
  <div
    class="relative h-full w-full lg:h-[534px] lg:max-h-[770px] bg-[#FBF9F4] backdrop-blur-[100px] overflow-hidden flex items-center justify-center"
  >
    <div
      class="flex w-full h-full items-center justify-center space-x-[-40px]"
    >
      <div
        class="w-32 md:w-80 h-full transform bg-[#FAF8F0] -skew-x-[15deg] shadow-[20px_0_10px_rgba(0,0,0,0.5)] z-[41] relative"
      >
      </div>
      <div
        class="w-32 md:w-80 h-full bg-[#E0719B] transform -skew-x-[15deg] shadow-[20px_0_40px_rgba(0,0,0,0.6)] z-40 relative"
      >
      </div>

      <div
        class="w-32 md:w-80 h-full bg-[#BC4F90] transform -skew-x-[15deg] shadow-[20px_0_40px_rgba(0,0,0,0.6)] z-30 relative"
      >
      </div>

      <div
        class="w-32 md:w-80 h-full bg-[#A35589] transform -skew-x-[15deg] shadow-[20px_0_40px_rgba(0,0,0,0.6)] z-20 relative"
      >
      </div>

      <div
        class="w-32 md:w-80 h-full bg-[#F0A5BC] transform -skew-x-[15deg] z-10 relative"
      >
      </div>
    </div>
  </div>
  <div
    class="min-h-[400px] h-full  lg:h-[500px] max-h-[600px] py-4 px-2 md:p-8 gap-8 w-full flex flex-col lg:flex-row justify-evenly items-center absolute inset-0 z-[100]"
  >
    <div
      class="flex flex-col justify-between w-full max-h-[500px] h-[460px]"
      id="hero"
    >
      <div class="flex flex-col gap-4 items-center lg:items-start">
        <h2 class="font-julius text-3xl md:text-5xl text-center lg:text-start">YOUR COLOR</h2>
        <hr class="border-2 border-black w-full lg:max-w-[333px] rounded-xl" />
        <p class="text-lg">Colores que complementan mejor con tigo</p>
      </div>
      <div class="flex justify-center items-center md:hidden h-full">
        <ImageAnimation />
      </div>
      <Button
        text="Comienza a explorar tu colorimetria hoy!"
        addClass="text-nowrap font-bold text-base md:text-xl flex justify-center lg:justify-start"
        link=""
        link1="#test"
        link2="hidden"
        button="hidden"
      />
    </div>
    <div class="hidden md:flex justify-center items-center ">
      <ImageAnimation />
    </div>
  </div>
  <!-- max-w-56 -->
</section>
