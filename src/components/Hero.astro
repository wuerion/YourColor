---
import Button from "./buttons.astro";
import Images from "../components/images.astro";
import ColorCircle from "../images/color-circle.webp";
import Background from "../images/background.png";
import Girl from "../images/imgsHero/1.webp";
import img from "../images/Frame77.svg";
import ImageAnimation from "./imageAnimation.astro";
---

<section class="h-screen">
  <!-- <Images
    ImgUrl={img}
    alt="background con lineas de colores"
    addClass="w-full"
    contClass="w-full absolute -z-10"
  /> -->
  <div
    class="relative w-full h-1/2 bg-[#FBF9F4] overflow-hidden flex items-center justify-center"
  >
    <div
      class="flex w-full h-[150%] items-center justify-center space-x-[-40px]"
    >
      <div
        class="w-32 md:w-80 h-full transform bg-[#FAF8F0] -skew-x-[15deg] shadow-[20px_0_10px_rgba(0,0,0,0.5)] z-[41] relative"
      >
      </div>
      <div
        class="w-32 md:w-80 h-full bg-[#E0719B] transform -skew-x-[15deg] shadow-[20px_0_40px_rgba(0,0,0,0.6)] z-40 relative"
      >
      </div>

      <div
        class="w-32 md:w-80 h-full bg-[#BC4F90] transform -skew-x-[15deg] shadow-[20px_0_40px_rgba(0,0,0,0.6)] z-30 relative"
      >
      </div>

      <div
        class="w-32 md:w-80 h-full bg-[#A35589] transform -skew-x-[15deg] shadow-[20px_0_40px_rgba(0,0,0,0.6)] z-20 relative"
      >
      </div>

      <div
        class="w-32 md:w-80 h-full bg-[#F0A5BC] transform -skew-x-[15deg] z-10 relative"
      >
      </div>
    </div>
  </div>
  <div
    class="h-1/2 p-8 w-full flex justify-between items-center absolute inset-0 z-[100] poniter-events-none"
  >
    <div
      class="flex flex-col justify-between w-full max-h-[500px] h-[460px]"
      id="hero"
    >
      <div class="flex flex-col gap-4">
        <h2 class="font-julius text-5xl w-fit items-center">YOUR COLOR</h2>
        <hr class="border-2 border-black max-w-[333px] rounded-xl" />
        <p>Colores que complementan mejor con tigo</p>
      </div>
      <Button
        text="Comienza a explorar tu colorimetria hoy!"
        addClass="text-nowrap font-bold text-xl"
        link=""
        link1="#test"
        link2="hidden"
        button="hidden"
      />
    </div>
    <div>
      <ImageAnimation />
    </div>
  </div>
  <div class="h-1/2 w-full flex items-center">
    <div class="w-1/2 flex flex-col items-center gap-16 p-8">
      <h1 class="text-xl">¿Que es la colorimetria personal?</h1>
      <p class="text-base max-w-[700px] min-w-[500px]">
        La colorimetria personal es una tecnica que identifica los colores que
        mas armonizan con las caracteristicas naturales de una persona, como <strong
          >tono de piel, color de ojos y cabello</strong
        >. Su objetivo es realzar su belleza natural, mejorando la apariencia y
        transmitir una imagen mas equilibrada y favorecedora.
      </p>
    </div>
    <div class="w-1/2 flex flex-col items-center gap-16 p-8">
      <h2 class="text-xl">¿Por que es importante conocer tu colorimetria?</h2>
      <p class="text-base max-w-[700px] min-w-[500px]">
        Conocer tu colorimetria es importante por que te permite identificar los
        colores que mas armonizan con tu <strong
          >tono de piel, ojos y cabello</strong
        >, potenciando tu belleza natural y proyectando una imagen mas
        equilibrada y atractiva. Esto se traduce en mayor confianza, ahorro de
        tiempo y dinero al elegir ropa y maquillaje, y una mejor impresion en
        contextos personales y profesionales.
      </p>
    </div>
  </div>
  <!-- max-w-56 -->
</section>
