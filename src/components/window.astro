---
import Buttons from "./buttons.astro";
import StacionColors from "./stacionColors.astro";
import Images from "../components/images.astro";
import exit from '/public/exit-icon.svg';
---

<div
    class="text-black text-lg hidden fixed top-5 lg:top-12 left-0 w-full h-dvh border border-black justify-center items-center flex-col"
    id="windowCard"
>
    <div
        class="bg-gray-400 w-full h-full lg:w-1/2 border rounded-lg shadow-black/40 shadow-sm p-5 overflow-scroll flex flex-col"
    >
        <button class="flex justify-end " id="exit">
            <!-- <img src="exit_out_close_icon.ico" alt="Exit" class="w-6 h-6"> -->
            <!-- <Images 
            mobileImgUrl={exit}
            desktopImgUrl={exit}
            alt="Exit"
            addClass="text-black"
            /> -->
            <Images 
            ImgUrl={exit}
            alt="exit"
            addClass=""
            />
        </button>
        <h2 class="text-center font-inconsolata text-2xl font-semibold">
            YOUR COLOR
        </h2>
        <p id="textResult"></p>
        <!--* asignar el valor de la variables -->
        <div id="container" class="grid grid-cols-1 lg:grid-cols-2 my-2 gap-2">
            <div class="w-full flex flex-col gap-2">
                <ul class="border w-full h-full p-2 rounded" id="list">
                    <p class="font-semibold">Datos ingresados</p>
                    <li id="item-1"></li>
                    <li id="item-2"></li>
                    <li id="item-3"></li>
                    <li id="item-4"></li>
                    <li id="item-5"></li>
                    <li id="item-6"></li>
                    <li id="item-7"></li>
                    <li id="item-8"></li>
                    <li id="item-9"></li>
                    <li id="item-10"></li>
                </ul>
            </div>
            <div class="w-full col-span-2" id="colorCard">
                <StacionColors />
            </div>
            <div class="border w-full p-2 mr-2 rounded col-span-2">
                <p>Otros datos</p>
                <p id="otrosDatos"></p>
                <ul class="flex flex-col gap-2">
                    <li class="border boredr-white p-2">
                        <p id="itemData-1"></p>
                    </li>
                    <li class="border boredr-white p-2">
                        <p id="itemData-2"></p>
                    </li>
                    <li class="border boredr-white p-2">
                        <p id="itemData-3"></p>
                    </li>
                    <li class="border boredr-white p-2">
                        <p id="itemData-4"></p>
                    </li>
                </ul>
                <p>Recuerda la colorometria es solo un regla la cual nos ayuda a comprender los colores que nos favorecen. <br> Pero no es obligatorio usarla recuerda utilizar los colores que mas te agraden y que te sientas comod@ utilizanlodos.</p>
            </div>
        </div>
        <Buttons
            text="Reiniciar"
            addClass="my-2"
            addClass="mb-7"
            button="border-white text-white"
            link="hidden"
            link2="hidden"
            id="resetButton"
        />
    </div>
</div>
