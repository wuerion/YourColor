---
import Image from "../components/images.astro";
import Spring from "../images/spring.webp";
import Summer from "../images/summer.webp";
import Autumn from "../images/autumn.webp";
import Winter from "../images/winter.webp";
---

<section
  class="w-full h-screen flex flex-col justify-center items-center gap-16"
>
  <h2 class="text-xl">
    <strong>La teoria de las estaciones</strong>
  </h2>

  <p class="max-w-[700px] min-w-[500px]">
    Las 12 estaciones es una evolucion del sitema tradicional de 4 estaciones en
    colorimetria, que permite una clasificasion mas precisa de los perfiles
    cromaticos
  </p>
  <p class="max-w-[700px] min-w-[500px]">
    Cada estacion principal <strong>(Primavera, Verano, Otoño, Invierno)</strong
    > se divide en 3 substaciones segun combinaciones de <strong
      >temperatura (calida/fria), intensidad (brillante/suave)</strong
    > y <strong>valor (claro/oscuro)</strong>
  </p>
  <div class="flex justify-around items-center w-full px-16">
    <div>
      <p class="font-julius text-center text-lg mb-8">Primavera</p>
      <Image ImgUrl={Spring} alt="" addClass="w-[300px] h-[300px] rounded-lg" />
    </div>
    <div>
      <p class="font-julius text-center text-lg mb-8">Verano</p>
      <Image ImgUrl={Summer} alt="" addClass="w-[300px] h-[300px] rounded-lg" />
    </div>
    <div>
      <p class="font-julius text-center text-lg mb-8">Otoño</p>
      <Image ImgUrl={Autumn} alt="" addClass="w-[300px] h-[300px] rounded-lg" />
    </div>
    <div>
      <p class="font-julius text-center text-lg mb-8">Invierno</p>
      <Image ImgUrl={Winter} alt="" addClass="w-[300px] h-[300px] rounded-lg" />
    </div>
  </div>
</section>
