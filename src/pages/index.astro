---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Test from "../components/Test.astro";
import Function from "../components/funcionamiento.astro";
import Window from "../components/window.astro";
import Images from "../components/images.astro";
import instagramMobile from '/public/instagramMobile.svg';
import instagramDesktop from '/public/instagramDesktop.svg';
import linkedinMobile from '/public/linkedinMobile.svg'
import linkedinDesktop from '/public/linkedinDesktop.svg'
import xDesktop from '/public/twitterDesktop.svg';
import xMobile from '/public/twitterMobile.svg';
---

<Layout title="Your Color | wuerion">
    <Header />
    <Hero />
    <About />
    <Function />
    <Test />
    <Window />
    <footer id="footer" class="bg-white/50 rounded text-black text-lg font-inconsolata px-5 py-2">
            <p class="text-center font-semibold my-2 w-full">&copy; 2025 Your Color/AXVOL</p>
        <div class="flex flex-col md:flex-row border-y border-gray-400 mt-5 p-2">
            <div class="w-full lg:w-1/2">
                <p>Gracias por visitar <span class="font-semibold">Your Color</span>. Esperamos que te haya servido para encontrar tus colores ideales.</p>
            </div>
            <div class="lg:w-1/2 my-2 text-center">
                <p class="text-center">Síguenos en nuestras redes sociales</p>
                <div class="flex justify-evenly items-center w-full">
                    <a href="https://www.instagram.com/wuerion47/" class="text-black text-center hover:text-white" target="_blank" rel="noopener noreferrer">
                        <Images
                        mobileImgUrl={instagramMobile}
                        desktopImgUrl={instagramDesktop}
                        alt="Instagram"
                        addClass="text-black"
                        />
                    </a>
                    <a href="https://www.linkedin.com/in/wuerion/" class="text-black text-center hover:text-white" target="_blank" rel="noopener noreferrer">
                        <Images 
                        mobileImgUrl={linkedinMobile}
                        desktopImgUrl={linkedinDesktop}
                        alt="Linkedin"
                        addClass="text-black "
                        />
                    </a>
                    <a href="https://twitter.com/WUERION_47" class="text-black text-center hover:text-white" target="_blank" rel="noopener noreferrer">
                        <Images 
                        mobileImgUrl={xMobile}
                        desktopImgUrl={xDesktop}
                        alt="twutter"
                        addClass=" text-black"
                        />
                    </a> 
                </div>
            </div>
        </div>
    </footer>
</Layout>
<script src="/utils/functions.js" defer is:inline></script>
<script src="/utils/vars.js" defer is:inline></script>
